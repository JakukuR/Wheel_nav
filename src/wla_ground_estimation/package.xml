<?xml version="1.0"?>
<package format="3">
  <name>wla_ground_estimation</name>
  <version>0.1.0</version>
  <description>Passive C++ wheel kinematics, attitude interpolation and local ground planes.</description>
  <maintainer email="robot@example.invalid">Robot Workspace Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
