<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <!-- Unicast-only discovery gives each participant an index and probes ports for
         indices 0..MaxAutoParticipantIndex. The default of 32 runs out when navigation
         runs beside follow, perception, agent and debug tools. Index 120 reaches the
         next domain's multicast ports, which stay unused while multicast is off. -->
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
    <Internal><SocketReceiveBufferSize min="8 MiB" max="8 MiB"/></Internal>
  </Domain>
</CycloneDDS>
