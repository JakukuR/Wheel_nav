builtin_interfaces/Time state_stamp
builtin_interfaces/Time last_visual_update_stamp
string instance_id
uint64 generation
uint8 INITIALIZING=0
uint8 VIO_TRACKING=1
uint8 INERTIAL_ONLY=2
uint8 RECOVERING=3
uint8 INVALID=4
uint8 STATIONARY=5
uint8 mode
bool initialized
bool state_valid
bool uncertainty_acceptable
float64 image_age_s
float64 imu_age_s
float64 visual_update_age_s
uint32 accepted_msckf_features
uint32 recovery_updates
uint64 rejected_imu
uint64 rejected_images
float64 position_std_max
float64 orientation_std_max
float64 velocity_std_max
string reason
# Accepted stationary constraints are separate from visual matching evidence.
bool zupt_enabled
uint64 zupt_updates
builtin_interfaces/Time last_zupt_update_stamp
float64 zupt_update_age_s
