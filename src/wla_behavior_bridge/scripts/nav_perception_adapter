#!/usr/bin/env python3
"""Nav-relative B whitelist and read-only Agent feedback. No model/TF/maps."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import time
import rclpy
from rclpy.node import Node
from std_msgs.msg import String
from ament_index_python.packages import get_package_share_directory
from wla_sim.behavior_bridge.agent_semantics import load_whitelist
from wla_sim.perception.relative_adapter import RelativeObservationAdapter


class AgentObservations(Node):
    def __init__(self, whitelist):
        super().__init__('wla_nav_perception_adapter')
        self.adapter = RelativeObservationAdapter(load_whitelist(whitelist, 'realtime'))
        self.obs_pub = self.create_publisher(String, '/r680/perception/observations', 1)
        self.visible_pub = self.create_publisher(String, '/wla_agent/visible_objects', 1)
        self.ctx_pub = self.create_publisher(String, '/r680/context/snapshot', 1)
        self.create_subscription(String, '/r680/perception/relative_objects', self.receive, 1)
        self.create_subscription(String, '/r680_nav/perception/status', self.status, 1)
        self.create_timer(.05, self.publish)

    def times(self):
        return dict(ros_ns=self.get_clock().now().nanoseconds, now=time.monotonic())

    def receive(self, msg):
        try:
            self.adapter.ingest(msg.data, **self.times())
        except (ValueError, TypeError, KeyError) as exc:
            self.get_logger().warning('relative observation rejected: '+str(exc), throttle_duration_sec=2.)

    def status(self, msg):
        try:
            if len(msg.data) < 8192:
                self.adapter.receive_status(json.loads(msg.data), **self.times())
        except (ValueError, TypeError, KeyError):
            pass

    def publish(self):
        clocks = self.times()
        snapshot = self.adapter.snapshot(**clocks)
        encoded = String(data=json.dumps(snapshot, ensure_ascii=False, allow_nan=False))
        self.obs_pub.publish(encoded)
        self.visible_pub.publish(encoded)
        context = self.adapter.context(snapshot, now=clocks['now'])
        self.ctx_pub.publish(String(data=json.dumps(context, ensure_ascii=False, allow_nan=False)))


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--whitelist', default=str(Path(get_package_share_directory('wla_behavior_bridge'))/'config/yolo_realtime_whitelist.json'))
    args = p.parse_args()
    workspace = Path(os.environ.get('WLA_ROS_WS', str(Path.home()/'ros2_ws')))
    (workspace/'.runtime').mkdir(exist_ok=True)
    lock = (workspace/'.runtime'/('nav-agent-observations-'+os.environ.get('ROS_DOMAIN_ID', '73')+'.lock')).open('w')
    fcntl.flock(lock, fcntl.LOCK_EX|fcntl.LOCK_NB)
    rclpy.init(args=[])
    node = AgentObservations(args.whitelist)
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
        lock.close()


if __name__ == '__main__':
    main()
