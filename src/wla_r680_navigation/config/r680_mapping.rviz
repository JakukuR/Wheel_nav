      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /optimal_trajectory
      Value: true
    - Alpha: 0.6499999761581421
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 100; 160; 255
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: MPPI Transformed Global Plan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /transformed_global_plan
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 0; 255; 80
      Enabled: true
      Name: Robot Footprint (0.20 x 0.20 m)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 120; 0
      Enabled: true
      Name: Collision Approach Region (0.32/0.27 x 0.52 m)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /FootprintApproach
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Active Navigation Goal
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r680_nav/goal_marker
      Value: true
    - Alpha: 0.7200000286102295
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: 0.15000000596046448
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0.30000001192092896
      Enabled: false
      Invert Rainbow: true
      Max Color: 255; 40; 40
      Max Intensity: 4
      Min Color: 40; 120; 255
      Min Intensity: 0.15000000596046448
      Name: D455 Near-field Points
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.02500000037252903
      Style: Flat Squares
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r680_nav/d455/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Angle Tolerance: 0.019999999552965164
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.30000001192092896
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Keep: 1
      Name: Fused Odometry
      Position Tolerance: 0.019999999552965164
      Shape:
        Alpha: 1
        Axes Length: 0.25
        Axes Radius: 0.019999999552965164
        Color: 255; 25; 0
        Head Length: 0.07000000029802322
        Head Radius: 0.03999999910593033
        Shaft Length: 0.15000000596046448
        Shaft Radius: 0.014999999664723873
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d455_slam/odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Furniture and Home
      Namespaces:
        furniture: true
        home: true
        semantic_labels: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r680_nav/semantic_markers
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF (toggle for debugging)
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /d455_slam/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r680_nav/goal_request
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 63.443538665771484
      Target Frame: r680_mapping_floor
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
