#!/usr/bin/env python3
"""Static server for the Kalo debug page, plus a byte relay from /ws to the
local foxglove_bridge, so the page needs one port and the bridge can listen on
127.0.0.1 only. Frames are copied, never parsed; this process never touches ROS."""
import argparse
import json
import os
import select
import socket
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


class Handler(SimpleHTTPRequestHandler):
    config = b'{}'
    bridge_port = 8765

    def do_GET(self):
        if self.path.split('?', 1)[0] == '/ws' and self.headers.get('Upgrade', '').lower() == 'websocket':
            self.relay_websocket()
            return
        if self.path.split('?', 1)[0] == '/config.json':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(self.config)))
            self.end_headers()
            self.wfile.write(self.config)
            return
        super().do_GET()

    def relay_websocket(self):
        try:
            upstream = socket.create_connection(('127.0.0.1', self.bridge_port), timeout=3)
        except OSError:
            self.send_error(502, 'foxglove_bridge is not running')
            return
        headers = ''.join(f'{k}: {v}\r\n' for k, v in self.headers.items() if k.lower() != 'host')
        upstream.sendall(f'GET / HTTP/1.1\r\nHost: 127.0.0.1:{self.bridge_port}\r\n{headers}\r\n'.encode())
        upstream.settimeout(None)
        self.connection.settimeout(None)
        self.close_connection = True
        ends = (self.connection, upstream)
        try:
            while True:
                ready, _, _ = select.select(ends, [], [], 30)
                for end in ready:
                    data = end.recv(65536)
                    if not data:
                        return
                    (upstream if end is self.connection else self.connection).sendall(data)
        except OSError:
            pass
        finally:
            upstream.close()

    def end_headers(self):
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Cache-Control', 'no-cache')  # revalidate, so an updated page loads at once
        super().end_headers()

    def log_message(self, *args):
        pass


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--host', default='0.0.0.0')
    p.add_argument('--port', type=int, default=18081)
    p.add_argument('--bridge-port', type=int, default=8765)
    p.add_argument('--base-frame', default='r680_mapping_floor')
    args = p.parse_args()
    root = Path(__file__).resolve().parents[1]/'kalo_web'
    if not root.is_dir():
        from ament_index_python.packages import get_package_share_directory
        root = Path(get_package_share_directory('wla_r680_navigation'))/'kalo_web'
    Handler.bridge_port = args.bridge_port
    Handler.config = json.dumps(dict(schema='kalo-debug/v1', bridge_port=args.bridge_port, base_frame=args.base_frame,
                                     domain=os.environ.get('ROS_DOMAIN_ID', '0'))).encode()
    try:
        os.nice(5)
    except OSError:
        pass
    server = ThreadingHTTPServer((args.host, args.port), partial(Handler, directory=str(root)))
    server.daemon_threads = True
    print(f'Kalo debug page: http://<robot-ip>:{args.port}/  (bridge ws port {args.bridge_port})', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
