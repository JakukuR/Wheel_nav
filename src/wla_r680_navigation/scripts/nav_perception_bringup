#!/usr/bin/env python3
"""Launch nav detection and an optional Agent consumer; no camera/motion bringup."""
import argparse
import sys
from pathlib import Path
from ament_index_python.packages import get_package_prefix, get_package_share_directory
from launch import LaunchDescription, LaunchService
from launch.actions import ExecuteProcess, RegisterEventHandler, EmitEvent
from launch.event_handlers import OnProcessExit
from launch.events import Shutdown


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--python', required=True)
    p.add_argument('--no-agent', action='store_true')
    p.add_argument('--debug', action='store_true', help='Also start the read-only Kalo debug page')
    p.add_argument('--no-window', action='store_true', help='Disable frozen-window consumer/export')
    p.add_argument('--window-config', default=None)
    p.add_argument('--cache-only', action='store_true')
    p.add_argument('--debug-port', type=int, default=18081)
    args, detector_args = p.parse_known_args()
    nav = Path(get_package_prefix('wla_r680_navigation'))/'lib/wla_r680_navigation/nav_yolo_detector'
    window = None
    if not args.no_agent and not args.no_window:
        from wla_sim.perception.observation_ipc import default_socket
        sock = default_socket()
        config = args.window_config or str(Path(get_package_prefix('wla_r680_navigation'))/'share/wla_r680_navigation/config/agent_observation_window.json')
        import json
        from wla_sim.perception.observation_window import WindowConfig
        settings = WindowConfig(**json.loads(Path(config).read_text()))
        detector_args += ['--observation-socket', sock,
            '--observation-max-age', str(settings.source_max_age_s),
            '--observation-metadata-items', str(settings.metadata_items),
            '--observation-clock-jump', str(settings.clock_jump_s),
            '--observation-queue-items', str(settings.export_queue_items),
            '--observation-queue-bytes', str(settings.export_queue_bytes),
            '--observation-ipc-timeout', str(settings.ipc_timeout_s)]
        window = ExecuteProcess(cmd=['/usr/bin/python3', str(nav.with_name('agent_observation_window')),
            '--config', config, '--socket', sock, *(['--cache-only'] if args.cache_only else [])], output='screen')
    detector = ExecuteProcess(cmd=[args.python,str(nav),*detector_args],output='screen')
    processes = [window, detector] if window else [detector]
    if args.debug:
        share = Path(get_package_share_directory('wla_r680_navigation'))
        processes += [
            ExecuteProcess(cmd=['ros2', 'run', 'foxglove_bridge', 'foxglove_bridge', '--ros-args', '-r', '__node:=kalo_bridge',
                                '--params-file', str(share/'config/kalo_bridge.yaml')], output='screen'),
            ExecuteProcess(cmd=[str(nav.with_name('kalo_jpeg')), '--ros-args', '-r', '__node:=kalo_jpeg'], output='screen'),
            ExecuteProcess(cmd=['/usr/bin/python3', str(nav.with_name('kalo_debug_web')), '--port', str(args.debug_port)], output='screen')]
    if not args.no_agent:
        bridge = Path(get_package_prefix('wla_behavior_bridge'))/'lib/wla_behavior_bridge/nav_perception_adapter'
        processes.append(ExecuteProcess(cmd=['/usr/bin/python3',str(bridge)],output='screen'))
    if not args.no_agent:
        person = Path(get_package_prefix('wla_behavior_bridge'))/'lib/wla_behavior_bridge/agent_person_api'
        processes.append(ExecuteProcess(cmd=['/usr/bin/python3',str(person)],output='screen'))
    actions = []
    failures = []
    def exited(event, context):
        if event.returncode not in (0, -2, 130):
            failures.append(event.returncode)
        return [EmitEvent(event=Shutdown(reason='perception component exited'))]
    for process in processes:
        if process is window:
            continue  # Agent exit cannot stop shared perception/Nav.
        actions.append(RegisterEventHandler(OnProcessExit(target_action=process,
            on_exit=exited)))
    service = LaunchService(noninteractive=not sys.stdin.isatty())
    service.include_launch_description(LaunchDescription([*actions,*processes]))
    code = service.run()
    return 1 if failures else code


if __name__ == '__main__':
    raise SystemExit(main())
