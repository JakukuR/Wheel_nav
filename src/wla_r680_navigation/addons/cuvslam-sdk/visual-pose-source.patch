+#include "common/include_gtest.h"
+#include "cuvslam/cuvslam2.h"
+
+namespace {
+cuvslam::Rig stereoRig(bool imu) {
+  cuvslam::Rig rig;
+  cuvslam::Camera camera{};
+  camera.size = {640, 480};
+  camera.principal = {320.f, 240.f};
+  camera.focal = {500.f, 500.f};
+  camera.rig_from_camera.rotation = {0.f, 0.f, 0.f, 1.f};
+  rig.cameras.push_back(camera);
+  camera.rig_from_camera.translation[0] = 0.05f;
+  rig.cameras.push_back(camera);
+  if (imu) {
+    cuvslam::ImuCalibration calibration{};
+    calibration.rig_from_imu.rotation = {0.f, 0.f, 0.f, 1.f};
+    calibration.gyroscope_noise_density = 0.000079f;
+    calibration.gyroscope_random_walk = 0.00002f;
+    calibration.accelerometer_noise_density = 0.0012f;
+    calibration.accelerometer_random_walk = 0.003f;
+    calibration.frequency = 200.f;
+    rig.imus.push_back(calibration);
+  }
+  return rig;
+}
+}
+
+TEST(LastPoseSource, InertialSourceIsInitializedBeforeFirstTrack) {
+  auto cfg = cuvslam::Odometry::GetDefaultConfig();
+  cfg.use_gpu = true;
+  cfg.odometry_mode = cuvslam::Odometry::OdometryMode::Inertial;
+  cuvslam::Odometry tracker(stereoRig(true), cfg);
+  EXPECT_FALSE(tracker.IsLastPoseInertialOnly());
+}
+
+TEST(LastPoseSource, VisualModeDoesNotReadAnInertialSolver) {
+  auto cfg = cuvslam::Odometry::GetDefaultConfig();
+  cfg.use_gpu = true;
+  cfg.odometry_mode = cuvslam::Odometry::OdometryMode::Multicamera;
+  cuvslam::Odometry tracker(stereoRig(false), cfg);
+  EXPECT_FALSE(tracker.IsLastPoseInertialOnly());
+}
