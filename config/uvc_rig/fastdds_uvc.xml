<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>uvc_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>uvc_shm</transport_id>
        <type>SHM</type>
        <!-- A raw 1080p BGR message is over 6 MB. Keep several in flight. -->
        <maxMessageSize>8388608</maxMessageSize>
        <segment_size>134217728</segment_size>
        <port_queue_capacity>128</port_queue_capacity>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="uvc_local_images" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>uvc_udp</transport_id>
          <transport_id>uvc_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
