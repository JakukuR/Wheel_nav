#!/usr/bin/env python3
import json
from io import BytesIO
import math
import queue
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

import numpy as np
import rclpy
import yaml
from PIL import Image as PILImage
from action_msgs.msg import GoalStatus, GoalStatusArray
from action_msgs.srv import CancelGoal
from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseStamped, PoseWithCovarianceStamped, Twist
from nav2_msgs.srv import ClearEntireCostmap
from nav_msgs.msg import OccupancyGrid, Odometry, Path as NavPath
from rclpy.duration import Duration
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import (
    DurabilityPolicy,
    HistoryPolicy,
    QoSProfile,
    ReliabilityPolicy,
    qos_profile_sensor_data,
)
from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2
from tf2_ros import Buffer, TransformException, TransformListener


_STATUS_NAMES = {
    GoalStatus.STATUS_UNKNOWN: 'unknown',
    GoalStatus.STATUS_ACCEPTED: 'accepted',
    GoalStatus.STATUS_EXECUTING: 'executing',
    GoalStatus.STATUS_CANCELING: 'canceling',
    GoalStatus.STATUS_SUCCEEDED: 'succeeded',
    GoalStatus.STATUS_CANCELED: 'canceled',
    GoalStatus.STATUS_ABORTED: 'aborted',
}


def _yaw(q):
    return math.atan2(
        2.0 * (q.w * q.z + q.x * q.y),
        1.0 - 2.0 * (q.y * q.y + q.z * q.z),
    )


def _quaternion(yaw):
    return math.sin(yaw * 0.5), math.cos(yaw * 0.5)


def _transform_points(points, transform):
    if points.size == 0:
        return points
    q = transform.rotation
    x, y, z, w = q.x, q.y, q.z, q.w
    rotation = np.array([
        [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
    ], dtype=np.float32)
    translation = np.array(
        [transform.translation.x, transform.translation.y, transform.translation.z],
        dtype=np.float32,
    )
    return points @ rotation.T + translation


class GatewayNode(Node):
    def __init__(self):
        super().__init__('r680_web_gateway')
        self.host = self.declare_parameter('host', '0.0.0.0').value
        self.port = int(self.declare_parameter('port', 8080).value)
        self.map_topic = self.declare_parameter('map_topic', '/r680/d455/map').value
        self.map_yaml = self.declare_parameter('map_yaml', '').value
        self.semantic_path = self.declare_parameter('semantic_path', '').value
        self.goal_topic = self.declare_parameter(
            'goal_topic', '/r680_nav/goal_request').value
        self.cmd_vel_topic = self.declare_parameter('cmd_vel_topic', '/cmd_vel_nav').value
        self.smoothed_cmd_vel_topic = self.declare_parameter(
            'smoothed_cmd_vel_topic', '/cmd_vel_smoothed').value
        self.max_obstacle_points = int(
            self.declare_parameter('max_obstacle_points', 800).value)

        self._lock = threading.Lock()
        self._commands = queue.Queue()
        self._tf_buffer = Buffer(cache_time=Duration(seconds=10.0))
        self._tf_listener = TransformListener(self._tf_buffer, self)
        self._map_png = None
        self._map_version = 0
        self._state = {
            'map': None,
            'semantic': {'map_id': '', 'revision': 0, 'home': None, 'furniture': []},
            'robot': None,
            'odom': {'vx': 0.0, 'wz': 0.0},
            'velocity_commands': {'cmd': None, 'smoothed': None},
            'global_path': [],
            'local_path': [],
            'near_obstacles': [],
            'confirmed_obstacles': [],
            'goal': None,
            'goal_status': 'idle',
            'ages': {},
        }
        self._received = {}

        map_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        if self.map_yaml:
            self._load_static_map(Path(self.map_yaml).expanduser())
        else:
            self.create_subscription(OccupancyGrid, self.map_topic, self._map_cb, map_qos)
        self.create_subscription(Odometry, '/d455_slam/odom', self._odom_cb, 10)
        self.create_subscription(
            Twist, self.cmd_vel_topic, lambda msg: self._velocity_cb(msg, 'cmd'), 10)
        self.create_subscription(
            Twist, self.smoothed_cmd_vel_topic,
            lambda msg: self._velocity_cb(msg, 'smoothed'), 10)
        self.create_subscription(NavPath, '/plan', self._global_path_cb, 2)
        self.create_subscription(NavPath, '/optimal_trajectory', self._local_path_cb, 2)
        self.create_subscription(
            PointCloud2, '/r680_nav/d455/points_viz',
            lambda msg: self._points_cb(msg, 'near_obstacles'), qos_profile_sensor_data)
        self.create_subscription(
            PointCloud2, '/r680_nav/d455/points_confirmed',
            lambda msg: self._points_cb(msg, 'confirmed_obstacles'), 2)
        self.create_subscription(
            GoalStatusArray, '/navigate_to_pose/_action/status', self._status_cb, 10)

        self._goal_pub = self.create_publisher(PoseStamped, self.goal_topic, 1)
        self._initial_pose_pub = self.create_publisher(
            PoseWithCovarianceStamped, '/d455_slam/initialpose', 1)
        self._cancel_client = self.create_client(
            CancelGoal, '/navigate_to_pose/_action/cancel_goal')
        self._clear_local = self.create_client(
            ClearEntireCostmap, '/local_costmap/clear_entirely_local_costmap')
        self._clear_global = self.create_client(
            ClearEntireCostmap, '/global_costmap/clear_entirely_global_costmap')
        self.create_timer(0.05, self._process_commands)
        self.create_timer(0.10, self._update_robot_pose)
        self.create_timer(1.0, self._load_semantic_layer)
        self._load_semantic_layer()

    def _load_semantic_layer(self):
        empty = {'map_id': '', 'revision': 0, 'home': None, 'furniture': []}
        semantic = empty
        if self.semantic_path:
            try:
                path = Path(self.semantic_path).expanduser()
                # The collector atomically replaces this small GeoJSON file.
                if path.stat().st_size > 2_000_000:
                    raise ValueError('semantic map is too large')
                document = json.loads(path.read_text(encoding='utf-8'))
                if (document.get('type') != 'FeatureCollection' or
                        document.get('schema') != 'wla-semantic-map-v1'):
                    raise ValueError('invalid semantic map schema')
                with self._lock:
                    selected_map = self._state['map']
                map_id = str(document.get('map_id', ''))
                if (selected_map and selected_map.get('map_id') and
                        map_id != selected_map['map_id']):
                    raise ValueError('semantic map belongs to another map')
                features = document.get('features', [])
                if not isinstance(features, list) or len(features) > 256:
                    raise ValueError('invalid semantic feature count')
                semantic = {'map_id': map_id,
                            'revision': int(document.get('revision', 0)),
                            'home': None, 'furniture': []}
                for feature in features:
                    if not isinstance(feature, dict):
                        continue
                    geometry = feature.get('geometry', {})
                    if geometry.get('type') != 'Point':
                        continue
                    coordinates = geometry.get('coordinates', [])
                    if len(coordinates) < 2:
                        continue
                    x, y = float(coordinates[0]), float(coordinates[1])
                    if not (math.isfinite(x) and math.isfinite(y)):
                        continue
                    props = feature.get('properties', {})
                    item = {'x': x, 'y': y,
                            'label': str(props.get('label', ''))[:48],
                            'id': str(feature.get('id', ''))[:64]}
                    if props.get('role') == 'home':
                        semantic['home'] = item
                    elif (props.get('role') == 'furniture' and
                          props.get('status') == 'confirmed'):
                        item['status'] = 'confirmed'
                        semantic['furniture'].append(item)
            except (OSError, ValueError, TypeError, KeyError, AttributeError):
                pass
        with self._lock:
            self._state['semantic'] = semantic

    def _mark(self, name):
        with self._lock:
            self._received[name] = time.monotonic()

    def _load_static_map(self, yaml_path):
        yaml_path = yaml_path.resolve()
        config = yaml.safe_load(yaml_path.read_text())
        image_path = Path(str(config['image'])).expanduser()
        if not image_path.is_absolute():
            image_path = yaml_path.parent / image_path
        pixels = np.asarray(PILImage.open(image_path).convert('L'), dtype=np.uint8)
        negate = bool(int(config.get('negate', 0)))
        occupancy = (pixels.astype(np.float32) if negate else 255.0 - pixels) / 255.0
        occupied_thresh = float(config.get('occupied_thresh', 0.65))
        free_thresh = float(config.get('free_thresh', 0.196))
        image = np.full(pixels.shape, 72, dtype=np.uint8)
        image[occupancy < free_thresh] = 238
        image[occupancy > occupied_thresh] = 12
        encoded = BytesIO()
        PILImage.fromarray(image).save(encoded, format='PNG')
        origin = list(config.get('origin', [0.0, 0.0, 0.0]))
        meta = {
            'version': 1,
            'width': int(pixels.shape[1]),
            'height': int(pixels.shape[0]),
            'resolution': float(config['resolution']),
            'origin_x': float(origin[0]),
            'origin_y': float(origin[1]),
            'origin_yaw': float(origin[2]),
            'frame': 'map',
            'map_id': yaml_path.parent.name,
            'source': 'selected_map',
        }
        with self._lock:
            self._map_version = 1
            self._map_png = encoded.getvalue()
            self._state['map'] = meta
        self._mark('map')
        self.get_logger().info(
            f'Web map pinned to {meta["map_id"]}: {yaml_path}')

    def _map_cb(self, msg):
        if msg.info.width == 0 or msg.info.height == 0:
            return
        data = np.asarray(msg.data, dtype=np.int16).reshape(
            (msg.info.height, msg.info.width))
        image = np.full(data.shape, 72, dtype=np.uint8)
        image[data == 0] = 238
        image[data >= 65] = 12
        image[(data > 0) & (data < 65)] = 150
        image = np.flipud(image)
        encoded = BytesIO()
        PILImage.fromarray(image).save(encoded, format='PNG')
        origin = msg.info.origin
        meta = {
            'version': self._map_version + 1,
            'width': int(msg.info.width),
            'height': int(msg.info.height),
            'resolution': float(msg.info.resolution),
            'origin_x': float(origin.position.x),
            'origin_y': float(origin.position.y),
            'origin_yaw': float(_yaw(origin.orientation)),
            'frame': msg.header.frame_id or 'map',
            'map_id': '',
            'source': 'ros_topic',
        }
        with self._lock:
            self._map_version += 1
            meta['version'] = self._map_version
            self._map_png = encoded.getvalue()
            self._state['map'] = meta
        self._mark('map')

    def _velocity_cb(self, msg, key):
        sample = {
            'vx': round(float(msg.linear.x), 3),
            'wz': round(float(msg.angular.z), 3),
        }
        with self._lock:
            self._state['velocity_commands'][key] = sample
            self._received['velocity_' + key] = time.monotonic()

    def _odom_cb(self, msg):
        with self._lock:
            self._state['odom'] = {
                'vx': round(float(msg.twist.twist.linear.x), 3),
                'wz': round(float(msg.twist.twist.angular.z), 3),
            }
        self._mark('odom')

    def _path_points(self, msg):
        poses = msg.poses
        if not poses:
            return []
        step = max(1, len(poses) // 600)
        points = np.asarray([
            [p.pose.position.x, p.pose.position.y, p.pose.position.z]
            for p in poses[::step]
        ], dtype=np.float32)
        frame = msg.header.frame_id or 'map'
        if frame != 'map':
            transform = self._tf_buffer.lookup_transform(
                'map', frame, rclpy.time.Time())
            points = _transform_points(points, transform.transform)
        return [[round(float(p[0]), 3), round(float(p[1]), 3)] for p in points]

    def _store_path(self, msg, key):
        try:
            points = self._path_points(msg)
        except TransformException:
            return
        with self._lock:
            self._state[key] = points
        self._mark(key)

    def _global_path_cb(self, msg):
        self._store_path(msg, 'global_path')

    def _local_path_cb(self, msg):
        self._store_path(msg, 'local_path')

    def _points_cb(self, msg, key):
        now = time.monotonic()
        if now - self._received.get(key, 0.0) < 0.25:
            return
        try:
            raw = point_cloud2.read_points_numpy(
                msg, field_names=['x', 'y', 'z'], skip_nans=True)
            points = np.asarray(raw)
            if points.dtype.fields:
                points = np.column_stack([points[n] for n in ('x', 'y', 'z')])
            points = points.reshape((-1, 3)).astype(np.float32, copy=False)
            if len(points) > self.max_obstacle_points:
                indices = np.linspace(
                    0, len(points) - 1, self.max_obstacle_points, dtype=np.int64)
                points = points[indices]
            if msg.header.frame_id and msg.header.frame_id != 'map':
                transform = self._tf_buffer.lookup_transform(
                    'map', msg.header.frame_id, rclpy.time.Time())
                points = _transform_points(points, transform.transform)
            rendered = [
                [round(float(point[0]), 3), round(float(point[1]), 3)]
                for point in points
            ]
        except Exception as error:
            self.get_logger().debug(f'point visualization skipped: {error}')
            return
        with self._lock:
            self._state[key] = rendered
        self._mark(key)

    def _status_cb(self, msg):
        status = 'idle'
        if msg.status_list:
            status = _STATUS_NAMES.get(msg.status_list[-1].status, 'unknown')
        with self._lock:
            self._state['goal_status'] = status
        self._mark('goal_status')

    def _update_robot_pose(self):
        try:
            transform = self._tf_buffer.lookup_transform(
                'map', 'r680_mapping_floor', rclpy.time.Time())
        except TransformException:
            return
        t = transform.transform.translation
        pose = {
            'x': round(float(t.x), 3),
            'y': round(float(t.y), 3),
            'yaw': round(float(_yaw(transform.transform.rotation)), 4),
        }
        with self._lock:
            self._state['robot'] = pose
        self._mark('robot')

    def enqueue(self, command, payload=None):
        self._commands.put((command, payload or {}))

    def _process_commands(self):
        while True:
            try:
                command, payload = self._commands.get_nowait()
            except queue.Empty:
                return
            if command in ('goal', 'initial_pose'):
                try:
                    x = float(payload['x'])
                    y = float(payload['y'])
                    yaw = float(payload.get('yaw', 0.0))
                    if not all(math.isfinite(value) for value in (x, y, yaw)):
                        raise ValueError('non-finite pose')
                except (KeyError, TypeError, ValueError):
                    self.get_logger().warning('rejected invalid web pose')
                    continue
                z, w = _quaternion(yaw)
                if command == 'goal':
                    msg = PoseStamped()
                    msg.header.frame_id = 'map'
                    msg.header.stamp = self.get_clock().now().to_msg()
                    msg.pose.position.x = x
                    msg.pose.position.y = y
                    msg.pose.orientation.z = z
                    msg.pose.orientation.w = w
                    self._goal_pub.publish(msg)
                    with self._lock:
                        self._state['goal'] = {'x': x, 'y': y, 'yaw': yaw}
                        self._state['goal_status'] = 'sent'
                else:
                    msg = PoseWithCovarianceStamped()
                    msg.header.frame_id = 'map'
                    msg.header.stamp = self.get_clock().now().to_msg()
                    msg.pose.pose.position.x = x
                    msg.pose.pose.position.y = y
                    msg.pose.pose.orientation.z = z
                    msg.pose.pose.orientation.w = w
                    msg.pose.covariance[0] = 0.25
                    msg.pose.covariance[7] = 0.25
                    msg.pose.covariance[35] = 0.0685
                    self._initial_pose_pub.publish(msg)
            elif command == 'cancel':
                if self._cancel_client.service_is_ready():
                    self._cancel_client.call_async(CancelGoal.Request())
                    with self._lock:
                        self._state['goal_status'] = 'canceling'
            elif command == 'clear_costmaps':
                request = ClearEntireCostmap.Request()
                if self._clear_local.service_is_ready():
                    self._clear_local.call_async(request)
                if self._clear_global.service_is_ready():
                    self._clear_global.call_async(ClearEntireCostmap.Request())

    def state_json(self):
        now = time.monotonic()
        with self._lock:
            state = json.loads(json.dumps(self._state))
            received = dict(self._received)
        state['server_time'] = time.time()
        state['ages'] = {
            key: round(now - stamp, 2) for key, stamp in received.items()
        }
        state['connected'] = {
            'map': state['map'] is not None,
            'robot': state['ages'].get('robot', 999.0) < 1.0,
            'odom': state['ages'].get('odom', 999.0) < 1.0,
        }
        return json.dumps(state, separators=(',', ':')).encode()

    def map_png(self):
        with self._lock:
            return self._map_png

class GatewayHandler(BaseHTTPRequestHandler):
    server_version = 'WLAWebGateway/1.0'

    @property
    def gateway(self):
        return self.server.gateway

    def log_message(self, fmt, *args):
        return

    def _send(self, code, body=b'', content_type='application/octet-stream'):
        self.send_response(code)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == '/api/state':
            return self._send(200, self.gateway.state_json(), 'application/json')
        if path == '/api/map.png':
            body = self.gateway.map_png()
            return self._send(200, body, 'image/png') if body else self._send(404)
        static = {'/': 'index.html', '/app.js': 'app.js', '/style.css': 'style.css'}
        name = static.get(path)
        if not name:
            return self._send(404, b'not found', 'text/plain')
        body = (self.server.web_root / name).read_bytes()
        mime = {
            '.html': 'text/html; charset=utf-8',
            '.js': 'application/javascript; charset=utf-8',
            '.css': 'text/css; charset=utf-8',
        }[Path(name).suffix]
        self._send(200, body, mime)

    def do_POST(self):
        path = urlparse(self.path).path
        actions = {
            '/api/goal': 'goal',
            '/api/initial_pose': 'initial_pose',
            '/api/cancel': 'cancel',
            '/api/clear_costmaps': 'clear_costmaps',
        }
        command = actions.get(path)
        if not command:
            return self._send(404)
        try:
            length = max(0, min(int(self.headers.get('Content-Length', '0')), 4096))
            payload = json.loads(self.rfile.read(length) or b'{}')
            if not isinstance(payload, dict):
                raise ValueError('body must be an object')
        except (ValueError, json.JSONDecodeError):
            return self._send(400, b'bad request', 'text/plain')
        self.gateway.enqueue(command, payload)
        self._send(202, b'{"accepted":true}', 'application/json')


def main():
    rclpy.init()
    node = GatewayNode()
    web_root = Path(get_package_share_directory('wla_r680_navigation')) / 'web'
    server = ThreadingHTTPServer((node.host, node.port), GatewayHandler)
    server.daemon_threads = True
    server.gateway = node
    server.web_root = web_root
    thread = threading.Thread(target=server.serve_forever, name='wla-http', daemon=True)
    thread.start()
    node.get_logger().info(
        f'WLA web gateway listening on http://{node.host}:{node.port}')
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        server.shutdown()
        server.server_close()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
