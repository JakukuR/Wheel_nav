#!/usr/bin/env python3
"""Wait for fresh mapping inputs, a first map and the manual safety chain."""
import argparse
import json
import os
from pathlib import Path
import time
import rclpy
from lifecycle_msgs.srv import GetState
from nav_msgs.msg import OccupancyGrid
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy, ReliabilityPolicy
from std_msgs.msg import Bool, String
from tf2_ros import Buffer, TransformListener


def init_diagnostics(run_dir):
    try:
        data = json.loads((run_dir/'vio_init.json').read_text())
        return {key: data[key] for key in ['reason', 'input_blocker', 'blocking_point_count',
                'blocking_cloud_fresh', 'first_blocking_point_xyz', 'inertial_ready',
                'mapping_or_localization_ready'] if key in data}
    except (OSError, ValueError, TypeError):
        return {}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--frontend', choices=['rgbd', 'cuvslam'], required=True)
    parser.add_argument('--auto-init', action='store_true')
    parser.add_argument('--run-dir', type=Path, required=True)
    parser.add_argument('--timeout', type=float, default=90)
    parser.add_argument('--bringup-pid', type=int)
    args = parser.parse_args()
    rclpy.init(); node = Node('r680_mapping_ready_waiter')
    tf = Buffer(); listener = TransformListener(tf, node)
    observed = {'interface': (False, 0), 'vio': (False, 0), 'gate': (False, 0)}
    state = {'init': '', 'init_at': 0, 'map': False, 'reason': 'waiting'}
    def health(name):
        def cb(msg): observed[name] = (msg.data, time.monotonic())
        return cb
    for name, topic in [('interface', '/r680_nav/localization_ready'),
                        ('vio', '/r680_nav/vio_tracking_healthy'), ('gate', '/r680_nav/mapping_odom_ready')]:
        node.create_subscription(Bool, topic, health(name), 1)
    def init_cb(msg): state.update(init=msg.data, init_at=time.monotonic())
    node.create_subscription(String, '/r680_nav/vio_init_state', init_cb, 1)
    def map_cb(msg):
        state['map'] = (msg.header.frame_id == 'map' and msg.info.width > 0 and msg.info.height > 0
                        and len(msg.data) == msg.info.width*msg.info.height)
    retained = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                         durability=DurabilityPolicy.TRANSIENT_LOCAL)
    node.create_subscription(OccupancyGrid, '/r680/d455/map', map_cb, retained)
    clients = {name: node.create_client(GetState, '/' + name + '/get_state')
               for name in ['velocity_smoother', 'collision_monitor']}
    futures, states = {}, {name: 0 for name in clients}
    seen = {name: 0 for name in clients}
    begin = time.monotonic(); last_poll = last_report = 0; stable = None
    result = {}
    try:
        while time.monotonic()-begin < args.timeout:
            rclpy.spin_once(node, timeout_sec=0.05); now = time.monotonic()
            if args.bringup_pid:
                try: os.kill(args.bringup_pid, 0)
                except ProcessLookupError: raise RuntimeError('建图主进程已退出')
            if args.auto_init and state['init'] == 'failed':
                diagnostics = init_diagnostics(args.run_dir)
                raise RuntimeError('自动初始化失败；不会开放手柄：' + json.dumps(diagnostics, ensure_ascii=False)
                                   + '；详情见 vio_init.json')
            for name, future in list(futures.items()):
                if future.done():
                    states[name] = future.result().current_state.id if future.result() else 0
                    seen[name] = now; del futures[name]
            if now-last_poll > 0.5:
                for name, client in clients.items():
                    if name not in futures and client.service_is_ready(): futures[name] = client.call_async(GetState.Request())
                last_poll = now
            valid = lambda name: observed[name][0] and now-observed[name][1] < 0.5
            tf_ok = tf.can_transform('map', 'r680_mapping_floor', rclpy.time.Time())
            init_ok = not args.auto_init or (state['init'] == 'succeeded' and now-state['init_at'] < 0.3)
            result = dict(frontend=args.frontend, interface_ready=valid('interface'),
                          vio_ready=valid('vio'), mapping_odom_ready=valid('gate'),
                          initialization=state['init'], map_received=state['map'],
                          map_to_base=bool(tf_ok), lifecycle=dict(states))
            if args.auto_init: result['initialization_diagnostics'] = init_diagnostics(args.run_dir)
            ready = (valid('interface') and state['map'] and tf_ok and init_ok
                     and all(states[n] == 3 and now-seen[n] < 2 for n in clients)
                     and (args.frontend == 'rgbd' or (valid('vio') and valid('gate'))))
            stable = (now if stable is None else stable) if ready else None
            if stable is not None and now-stable >= 0.5:
                state['reason'] = 'ready'; return
            if now-last_report > 10:
                print('[R680] 等待建图就绪:', json.dumps(result, ensure_ascii=False), flush=True)
                last_report = now
        raise RuntimeError(f'{args.timeout:g} 秒内建图未就绪；检查 logs/bringup.log 和 vio_init.json')
    except Exception as error:
        state['reason'] = str(error); raise SystemExit(state['reason'])
    finally:
        result.update(ready=state['reason'] == 'ready', reason=state['reason'],
                      initialization=state['init'], map_received=state['map'])
        if args.auto_init: result['initialization_diagnostics'] = init_diagnostics(args.run_dir)
        (args.run_dir/'mapping_readiness.json').write_text(json.dumps(result, indent=2)+'\n')
        node.destroy_node(); rclpy.shutdown()


if __name__ == '__main__': main()
