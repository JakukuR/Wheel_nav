#!/usr/bin/env python3
"""Accept an intentional map.pgm edit after geometry and bundle validation."""
import argparse
import json
from pathlib import Path

from ament_index_python.packages import get_package_share_directory
from wla_r680_navigation_py.storage import (
    accept_navigation_map_edit, load_storage_config)


def main():
    share = Path(get_package_share_directory('wla_r680_navigation'))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--storage-config', type=Path, default=share/'config/storage.yaml')
    parser.add_argument('--map', required=True, help='Explicit map directory name.')
    parser.add_argument('--reason', required=True, help='Why this PGM edit is intentional.')
    args = parser.parse_args()
    try:
        result = accept_navigation_map_edit(
            load_storage_config(args.storage_config), args.map, args.reason)
    except (ValueError, OSError, KeyError) as exc:
        parser.exit(1, f'Map edit rejected: {exc}\n')
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
