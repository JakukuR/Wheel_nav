#!/usr/bin/env python3
"""Resolve an immutable map bundle for RTAB-Map localization and 2D Nav2."""
import argparse
import json
from pathlib import Path

from ament_index_python.packages import get_package_share_directory

from wla_r680_navigation_py.storage import load_storage_config, resolve_navigation_map


def main():
    share = Path(get_package_share_directory('wla_r680_navigation'))
    parser = argparse.ArgumentParser()
    parser.add_argument('--storage-config', type=Path, default=share/'config/storage.yaml')
    parser.add_argument('--map', dest='selection', default=None,
                        help='Map directory name; defaults to storage.yaml active_map.')
    args = parser.parse_args()
    storage = load_storage_config(args.storage_config)
    try:
        result = resolve_navigation_map(storage, args.selection)
    except (ValueError, OSError) as exc:
        message = str(exc)
        if message == 'navigation map checksum mismatch: map.pgm':
            message += ('\nIf map.pgm was intentionally edited, validate and accept it with:\n'
                        '  ros2 run wla_r680_navigation accept_navigation_map_edit '
                        '--map <map-name> --reason <edit-description>')
        parser.exit(1, message+'\n')
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
